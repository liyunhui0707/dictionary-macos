{
  "manifest_version": 3,
  "name": "Dictionary Lookup",
  "version": "0.1.0",
  "description": "Send selected text + paragraph context to the Dictionary macOS app for context-aware translation.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1:49152/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Look up the selected text via the Dictionary app"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
